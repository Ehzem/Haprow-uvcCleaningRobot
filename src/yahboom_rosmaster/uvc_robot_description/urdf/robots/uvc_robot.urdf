  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.0019" iyy="0.0032" izz="0.0019" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision>
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".08" length=".0613" />
      </geometry>
    </collision>
    <visual name="cad_part_18">
      <geometry>
        <mesh filename="package://uvc_robot_description/meshes/uvc_robot/part_18.stl" />
      </geometry>
      <material name="material_18">
        <color rgba="0.152941 0.152941 0.152941 1" />
      </material>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 0.16022 .08" />
    <axis xyz="0 1 0" />
    <limit effort="25" velocity="10" />
  </joint>
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.0019" iyy="0.0032" izz="0.0019" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision>
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".08" length=".0613" />
      </geometry>
    </collision>
    <visual name="cad_part_16">
      <geometry>
        <mesh filename="package://uvc_robot_description/meshes/uvc_robot/part_16.stl" />
      </geometry>
      <material name="material_16">
        <color rgba="0.152941 0.152941 0.152941 1" />
      </material>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 -0.16022 .08" />
    <axis xyz="0 1 0" />
    <limit effort="25" velocity="10" />
  </joint>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="left_caster_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision>
      <geometry>
        <sphere radius=".03725" />
      </geometry>
    </collision>
  </link>
  <joint name="left_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_caster_link" />
    <origin xyz=".274 0.15 .03725" />
  </joint>
  <gazebo reference="left_caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="left_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <link name="right_caster_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision>
      <geometry>
        <sphere radius=".03725" />
      </geometry>
    </collision>
  </link>
  <joint name="right_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_caster_link" />
    <origin xyz=".274 -0.15 .03725" />
  </joint>
  <gazebo reference="right_caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="right_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="1e-05" iyy="1e-05" izz="1e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz=".39 0 .34" />
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="1e-05" iyy="1e-05" izz="1e-05" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz=".10 0 .20" />
  </joint>
  <gazebo reference="laser_frame">
    <sensor name="uvc_lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>.12</min>
          <max>20</max>
          <resolution>.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="uvc_imu" type="imu">
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>.32044</wheel_separation>
      <wheel_radius>.08</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>.3</max_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity>
      <max_linear_acceleration>.5</max_linear_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>